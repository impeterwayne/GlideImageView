    <string name="shape_grayscale">Grayscale*</string>
    <string name="shape_circle_gray">Circle + Gray</string>
    <string name="shape_rounded_border">Rounded + Border*</string>
    <string name="shape_squircle_gray">Squircle + Gray</string>

