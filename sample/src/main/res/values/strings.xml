    <string name="app_name">GlideImageView Sample</string>
    <string name="header_title">GlideImageView</string>
    <string name="header_subtitle">Declarative XML loading via app:glideSrc, composable shapes, and extensible request pipelines.</string>

    <string name="tab_basics">XML Attributes</string>
    <string name="tab_shapes">Shapes</string>
    <string name="tab_list">List (1000)</string>
